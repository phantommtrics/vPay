PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vpay?schema=public
JWT_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=info@yourdomain.com
APP_NAME=vPay
ADMIN_API_KEY=change-me-admin-key
ADMIN_TOTP_ISSUER=vPay Admin
# Comma-separated origins for admin portal + Expo dev
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Admin portal URL used in web push notification links
ADMIN_APP_URL=http://localhost:5173
# Production (admin served on same host as API via nginx):
# ADMIN_APP_URL=https://api.vpayafrica.phantommetrics.gm
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081,https://api.vpayafrica.phantommetrics.gm

# Web push for admin KYC alerts (generate: cd backend && npm run admin:push-vapid)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@vpay.com

# Stripe (Issuing + Connect stablecoin preview)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ISSUING_PLATFORM_PROGRAM=iprg_...
# Leave unset or use a placeholder (iprg_...) until Stripe enrolls you in stablecoin Issuing.
# Without a real program id, cards use legacy UK Issuing (GBP by default).
# Platform USDC pool — run: npx tsx scripts/setup-stripe-platform-financial-account.ts
STRIPE_PLATFORM_FINANCIAL_ACCOUNT_ID=fa_...
STRIPE_API_VERSION=2026-05-27.preview

# Legacy UK Issuing sandbox (default when STRIPE_ISSUING_PLATFORM_PROGRAM is unset/placeholder)
# Gambian users are auto-mapped to GB billing until stablecoin preview is enabled.
# Optional overrides:
# STRIPE_ISSUING_CURRENCY=gbp
# STRIPE_TEST_CARDHOLDER_COUNTRY=gb
# STRIPE_TEST_CARDHOLDER_POSTAL_CODE=SW1A 1AA

# One-time fee debited from vPay wallet before card provisioning (GMD = fee * exchange rate)
# Fallback when catalog settlement config is unavailable
CARD_ISSUANCE_FEE_USD=1.5
# Virtual card expiration passed to Stripe on create (exp_month / exp_year)
CARD_EXPIRY_YEARS=1

# directPay internal partner (optional — fund + provision disabled when unset)
DIRECTPAY_API_BASE_URL=http://localhost:4000
INTERNAL_PARTNER_API_SECRET=shared-with-directPay
INTERNAL_PARTNER_WEBHOOK_SECRET=shared-with-directPay
VPAY_PUBLIC_API_URL=http://localhost:3001

# Card funding summary (GMD → USD conversion and platform fee)
# Used as fallbacks when catalog/UCP settlement config is unavailable
FUND_EXCHANGE_RATE=71
FUND_FEE_PERCENT=0.02

# GMD/USD exchange rate auto-sync (ExchangeRate-API — https://www.exchangerate-api.com/)
# Updates the catalog UCP "gmd-usd-exchange-rate" on a schedule when enabled.
EXCHANGE_RATE_API_KEY=
# EXCHANGE_RATE_SYNC_ENABLED=true
# Poll interval in ms (default 60000 = 1 minute for testing; use 3600000 for hourly in production)
EXCHANGE_RATE_SYNC_INTERVAL_MS=60000
# EXCHANGE_RATE_API_BASE_URL=https://v6.exchangerate-api.com/v6
# EXCHANGE_RATE_BASE_CURRENCY=USD
# EXCHANGE_RATE_TARGET_CURRENCY=GMD

# App update (mobile shows a bottom sheet on any screen via GET /api/app/config)
# Prefer setting APP_MIN_* so users who already updated are not blocked.
# APP_FORCE_UPDATE=true with no mins → prompt everyone.
# APP_FORCE_UPDATE=true with mins → only outdated installs see the sheet.
# APP_FORCE_UPDATE=true
# APP_MIN_VERSION=1.0.5
# APP_MIN_IOS_VERSION=1.0.5
# APP_MIN_ANDROID_VERSION=1.0.5
# APP_MIN_IOS_BUILD=12
# APP_MIN_ANDROID_VERSION_CODE=7
# APP_IOS_STORE_URL=https://apps.apple.com/app/idXXXXXXXX
# APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=gm.phantommetrics.vpay
# APP_UPDATE_MESSAGE=Please update vPay to continue.

# Dev only — auto-enabled when NODE_ENV is not production (set false to disable)
# FUND_SIMULATION_ENABLED=true

# Optional: override auto-created test inbound payment method (run setup script to discover)
# STRIPE_TEST_INBOUND_PAYMENT_METHOD=
# Setup: cd backend && npx tsx scripts/setup-stripe-test-inbound.ts user@example.com
