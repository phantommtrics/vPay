PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vpay?schema=public
JWT_SECRET=change-me-to-a-long-random-string
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=info@yourdomain.com
APP_NAME=vPay
ADMIN_API_KEY=change-me-admin-key

# Stripe (Issuing + Connect stablecoin preview)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ISSUING_PLATFORM_PROGRAM=iprg_...
STRIPE_ISSUING_CURRENCY=gbp
# UK test Issuing rejects GM addresses — use gb for local sandbox testing
STRIPE_TEST_CARDHOLDER_COUNTRY=gb
STRIPE_API_VERSION=2026-05-27.preview

# directPay internal partner (optional — fund + provision disabled when unset)
DIRECTPAY_API_BASE_URL=http://localhost:4000
INTERNAL_PARTNER_API_SECRET=shared-with-directPay
INTERNAL_PARTNER_WEBHOOK_SECRET=shared-with-directPay
VPAY_PUBLIC_API_URL=http://localhost:3001

# Card funding summary (GMD → USD conversion and platform fee)
FUND_EXCHANGE_RATE=71
FUND_FEE_PERCENT=0.02

# Dev only — auto-enabled when NODE_ENV is not production (set false to disable)
# FUND_SIMULATION_ENABLED=true

# Optional: override auto-created test inbound payment method (run setup script to discover)
# STRIPE_TEST_INBOUND_PAYMENT_METHOD=pm_...
# Setup: cd backend && npx tsx scripts/setup-stripe-test-inbound.ts user@example.com
