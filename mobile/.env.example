# Local dev — auto-detected from Expo dev server on physical devices when unset
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# Required for Play Store / release builds (baked into the app at build time)
# EXPO_PUBLIC_API_URL=https://your-production-api.example.com

# Production Play Store builds — set in EAS, not in a committed .env file:
# eas secret:create --scope project --name EXPO_PUBLIC_API_URL --value https://your-production-api.example.com
# eas secret:create --scope project --name EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY --value pk_live_...

# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
